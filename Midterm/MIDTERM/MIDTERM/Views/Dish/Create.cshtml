@model MIDTERM.Models.Dish_BIT240199
@{
    ViewData["Title"] = "Create New Dish Record";
}

<div class="container mt-4">
    <h2>Create New System Dish (ID: BIT240199)</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Dish Identity Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DishCategoryId" class="form-label">Category Assignment</label>
                    <select asp-for="DishCategoryId" class="form-select" asp-items="ViewBag.DishCategoryId">
                        <option value="">-- Assign a Category --</option>
                    </select>
                    <span asp-validation-for="DishCategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Base Price (VND)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PreparationTime" class="form-label">Required Prep Time (minutes)</label>
                    <input asp-for="PreparationTime" type="number" class="form-control" />
                    <span asp-validation-for="PreparationTime" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                    <label asp-for="IsAvailable" class="form-check-label">Set Flag to Active Market Trading</label>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Internal Meta Notes</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Save Record</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}