@model IEnumerable<MIDTERM.Models.Dish_BIT240199>

@{
    ViewData["Title"] = "DISH MANAGEMENT";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Dish Management Menu (ID: BIT240199)</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary">Add New Dish</a>
            <a asp-action="Categories" class="btn btn-outline-secondary">Manage Categories</a>
        </div>
    </div>

    <div class="card bg-light p-3 mb-4">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label font-weight-bold">Dish Name</label>
                <input type="text" name="searchTerm" class="form-control" value="@ViewBag.SearchTerm" placeholder="Search keyword..." />
            </div>
            <div class="col-md-3">
                <label class="form-label font-weight-bold">Category</label>
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label font-weight-bold">Status</label>
                <select name="availability" class="form-select">
                    <option value="">-- All Status --</option>
                    <option value="Available" selected="@(ViewBag.SelectedAvailability == "Available")">Available</option>
                    <option value="Unavailable" selected="@(ViewBag.SelectedAvailability == "Unavailable")">Unavailable</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label font-weight-bold">Price From</label>
                <input type="number" name="minPrice" class="form-control" value="@ViewBag.MinPrice" />
            </div>
            <div class="col-md-2">
                <label class="form-label font-weight-bold">Price To</label>
                <input type="number" name="maxPrice" class="form-control" value="@ViewBag.MaxPrice" />
            </div>
            <div class="col-md-4">
                <label class="form-label font-weight-bold">Sort By</label>
                <select name="sortBy" class="form-select">
                    <option value="">-- Default Ordering --</option>
                    <option value="PriceAsc" selected="@(ViewBag.SortBy == "PriceAsc")">Price: Low to High</option>
                    <option value="PriceDesc" selected="@(ViewBag.SortBy == "PriceDesc")">Price: High to Low</option>
                    <option value="PrepTimeAsc" selected="@(ViewBag.SortBy == "PrepTimeAsc")">Preparation Time: Shortest First</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-success me-2 w-50">Apply Filter</button>
                <a asp-action="Index" class="btn btn-secondary w-50">Reset Filters</a>
            </div>
        </form>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (ViewBag.NoResultIndexMessage != null)
    {
        <div class="alert alert-warning text-center">@ViewBag.NoResultIndexMessage</div>
    }

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Thumbnail</th>
                <th>Dish Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Prep Time</th>
                <th>Classification</th>
                <th>Status</th>
                <th style="width: 220px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string rowClass = item.IsAvailable ? "" : "table-danger";
                var thumbImg = item.DishImages.FirstOrDefault(i => i.IsThumbnail);

                <tr class="@rowClass">
                    <td class="text-center">
                        @if (thumbImg != null)
                        {
                            <img src="@thumbImg.ImageUrl" alt="@item.Name" style="width:70px; height:50px; object-fit:cover;" class="rounded border" />
                        }
                        else
                        {
                            <span class="text-muted small"><em>No Thumbnail</em></span>
                        }
                    </td>
                    <td><strong>@item.Name</strong></td>
                    <td>@item.DishCategory?.Name</td>
                    <td>@item.Price.ToString("N0") VND</td>
                    <td>@item.PreparationTime mins</td>
                    <td>
                        @if (item.PreparationType == "Fast")
                        {
                            <span class="badge bg-success text-white">Fast (≤15m)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-white">Normal (>15m)</span>
                        }
                    </td>
                    <td>
                        @if (item.IsAvailable)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Suspended</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-info text-white">Images & Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
